VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-measurement-id
VITE_FIREBASE_VAPID_KEY=replace-with-your-firebase-web-push-key

FIREBASE_ADMIN_SDK_BASE64=replace-with-base64-service-account-json
ADMIN_NOTIFICATION_KEY=replace-with-a-random-admin-secret
WHATSAPP_TOKEN=replace-with-your-meta-whatsapp-token
WHATSAPP_PHONE_ID=replace-with-your-meta-phone-number-id
WHATSAPP_OTP_TEMPLATE=otp_login
WHATSAPP_OTP_LANG=en_US
# Gemini API key(s). You can list MULTIPLE keys separated by commas to multiply
# the free-tier daily quota (free quota is per Google project, so use keys from
# different projects/accounts). The server rotates across them and also falls
# back across models on a 429. Optional: GEMINI_MODELS to override the model chain.
GEMINI_API_KEY=key-one,key-two,key-three
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite,gemini-2.0-flash-lite

VITE_METERED_TURN_API_URL=https://your-subdomain.metered.live/api/v1/turn/credentials
VITE_METERED_TURN_API_KEY=replace-with-your-metered-turn-api-key
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Razorpay — server-side (NEVER expose the secret to the frontend)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
# Razorpay — public key id, safe to ship to the browser (used by checkout.js)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
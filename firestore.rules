rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS (The "Brain" of the Rules) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // --- TEAM (staff logins, see src/lib/permissions.ts) ---
    // users/{uid}: role 'staff', isActive, permissions: ['products', 'content', ...].
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isTeam() {
      return isAuthenticated() && profile().get('role', '') == 'staff' && profile().get('isActive', true) != false;
    }
    // Owner, or an active team member given this page.
    function can(perm) {
      return isAdmin() || (isTeam() && perm in profile().get('permissions', []));
    }
    function isAdminOrTeam() {
      return isAdmin() || isTeam();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownAccountStatusChangeAllowed(before, after) {
      return after == before ||
             (before != 'suspended' && after in ['active', 'pending_deletion']);
    }

    // --- USER RULES (Profiles, Addresses, History, & Security) ---
    match /users/{userId} {
      // Admin can see everyone; Users can see their own profile
      allow read: if isOwner(userId) || can('customers');
      
      // Admin can create delivery boys; Users can create their own profile.
      // A self-created profile must be an ordinary customer: before this, the
      // create rule accepted any role, so a new account could write
      // `role: 'admin'` into its own document and get the whole admin panel.
      allow create: if isAdmin() || (
        isOwner(userId) && request.resource.data.get('role', 'user') == 'user'
      );

      // Admin can update everything; Users can update own info.
      // Users CANNOT change their role. They may move their own accountStatus
      // only between 'active' and 'pending_deletion' - requesting and cancelling
      // account deletion, and the automatic unlock after a login lockout, all
      // run from the customer's browser - but never out of an admin's
      // 'suspended'. `.get()` with a default, so a document that never had the
      // field is compared safely instead of erroring.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
        // A team member cannot give themselves pages or switch themselves back on.
        request.resource.data.get('permissions', null) == resource.data.get('permissions', null) &&
        request.resource.data.get('staffRole', null) == resource.data.get('staffRole', null) &&
        (resource.data.get('role', 'user') != 'staff' ||
          request.resource.data.get('isActive', true) == resource.data.get('isActive', true)) &&
        ownAccountStatusChangeAllowed(
          resource.data.get('accountStatus', 'active'),
          request.resource.data.get('accountStatus', 'active'))
      );

      // Only Admin can delete users
      allow delete: if isAdmin();
      
      // --- Addresses ---
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // --- Browsing History ---
      match /history/{historyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // --- WISHLIST ---
      match /wishlist/{productId} {
        allow read: if isOwner(userId) || can('customers'); // Customer details
        allow write: if isOwner(userId) || isAdmin();
      }

      // --- ORDER HISTORY (read by Customer details; nothing writes it today) ---
      match /orders/{orderId} {
        allow read: if isOwner(userId) || can('customers');
      }
      
      // --- GIFT CARDS SUBCOLLECTION ---
      match /giftCards/{giftCardId} {
        allow read: if isOwner(userId) || can('giftCards');
        // Only admin can create/update/delete gift cards
        allow write: if can('giftCards');
      }

      // --- WALLET (subcollection) ---
      // Nothing in the app writes wallets today. A customer used to be able
      // to set their own balance; now only the owner (and the server) can.
      match /wallets/{walletId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin();
        allow delete: if false; // NEVER delete wallets
      }
      
      // --- TRANSACTIONS (append-only ledger) ---
      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        // Transactions can be created but NEVER edited or deleted
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isAdmin(); // Only admin can update status (e.g., expire)
        allow delete: if false; // Immutable transaction log
      }
      
      // --- REWARDS ---
      match /rewards/{rewardId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin(); // For redemption
        allow delete: if false; // Never delete reward entries
      }
      
      // --- PAYMENT METHODS (Razorpay ready) ---
      match /paymentMethods/{methodId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin(); // Only admin can hard-delete
      }
      
      // --- LOGIN HISTORY (append-only security log) ---
      match /loginHistory/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if false; // Immutable
        allow delete: if isAdmin(); // Admin cleanup only
      }
      
      // --- SESSIONS ---
      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin(); // For termination
        allow delete: if isAdmin();
      }
      
      // --- TRUSTED DEVICES ---
      match /trustedDevices/{deviceId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
      
      // --- AUDIT LOG (append-only) ---
      match /auditLog/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if false; // Immutable audit trail
        allow delete: if false; // Never delete audit logs
      }
    }
    
    // --- GIFT CARDS (global collection) ---
    match /giftCards/{cardId} {
      allow read: if isAuthenticated();
      // Nothing redeems these from the browser; any signed-in user could
      // rewrite a balance while update was isAuthenticated().
      allow create, update, delete: if can('giftCards');
    }

    // --- GIFT CARDS collection-group read (admin manager fast query) ---
    // Lets the admin gift card manager load every user's gift cards with one
    // collectionGroup('giftCards') query instead of scanning users one by one.
    // Writes stay governed by the specific per-user path rule above.
    match /{path=**}/giftCards/{giftCardId} {
      allow read: if can('giftCards');
    }
    
    // --- REFUNDS (global collection) ---
    match /refunds/{refundId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || can('orders')
      );
      allow create: if isAuthenticated();
      allow update: if can('orders'); // Only admin processes refunds
      allow delete: if false;
    }
    
    // --- ADMIN WALLET LOG ---
    match /adminWalletLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false; // Immutable
      allow delete: if false;
    }
    
    // --- ACCOUNT DELETION REQUESTS ---
    match /accountDeletionRequests/{requestId} {
      // Queries must ask for the user's own requests (where userId == uid).
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Allow get: users can read their own requests or admin can read all
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- STOREFRONT CONTENT & SETTINGS ---
    // These had no rule, which in production meant "denied": the homepage
    // banners, collections and videos would not load, and neither would the
    // delivery, GST and silver-rate settings checkout prices from. Everyone
    // may read them; only admins may change them. `siteSettings/catalogVersion`
    // is written by the server with the Admin SDK, which bypasses these rules.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        || (docId in ['delivery', 'gst', 'customerSupport', 'coupons', 'jewelleryOffer'] && can('commerce'))
        || (docId == 'silverRate' && can('silverRate'))
        // adminNotification (where order alerts go) belongs to the owner-only
        // Settings page, so it is not website content.
        || (!(docId in ['delivery', 'gst', 'customerSupport', 'coupons', 'jewelleryOffer', 'silverRate', 'dealerChat', 'catalogVersion', 'adminNotification'])
            && can('content'));
    }
    match /homeBanners/{docId} {
      allow read: if true;
      allow write: if can('content');
    }
    match /homeCollections/{docId} {
      allow read: if true;
      allow write: if can('content');
    }
    match /homeVideos/{docId} {
      allow read: if true;
      allow write: if can('content');
    }

    // --- NEWSLETTER ---
    // A visitor may add their own address and nothing else. The document id is
    // the address, so a repeat is refused as an update rather than detected by
    // reading the list - which would expose every subscriber's email.
    match /newsletterSubscriptions/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
        && request.resource.data.email == email
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && email.size() <= 254;
      allow read, delete: if can('newsletter');
      allow update: if false;
    }

    // --- DELIVERY RATINGS ---
    // Left by the customer for their own order; read by the shop and by the
    // delivery partner who was rated.
    match /deliveryRatings/{ratingId} {
      allow create: if isAuthenticated() && request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.get('deliveryBoyId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      ));
      allow update, delete: if isAdmin();
    }

    // --- ADMIN TOOLS ---
    match /promptHistory/{docId} {
      allow read, write: if can('aiTools');
    }

    // --- STORE MANAGEMENT (Products & Admin Data) ---
    match /products/{productId} {
      allow read: if true;
      // At most 5 photos per product (MAX_PRODUCT_IMAGES in src/services/mediaStorage.ts).
      // An update that leaves the photo list as it was is still allowed, so an
      // older product with more photos can get stock/price edits before it's trimmed.
      allow create: if can('products') && productImages(request.resource.data).size() <= 5;
      allow update: if (can('products') && (
        productImages(request.resource.data).size() <= 5 ||
        productImages(request.resource.data) == productImages(resource.data)
      )) || (isAuthenticated() && isStockOnlyChange());
      allow delete: if can('products');
    }

    function productImages(data) {
      return data.get('media', {}).get('images', []);
    }

    // What a customer's own order is allowed to change on a product: the stock
    // count, and the sold-out hide/restore that goes with it. Checkout decrements
    // stock inside the order transaction and a cancellation puts it back, both
    // from the customer's browser, so these must be writable by them - but
    // price, name, photos and every other field stay admin-only. That is what
    // stops a shopper from setting a Rs.38,000 piece to Rs.1 and checking out,
    // since the payment server prices orders from these very documents.
    function isStockOnlyChange() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys()
               .hasOnly(['inventory', 'flags', 'inactiveReason', 'outOfStockAt', 'updatedAt'])
        && after.inventory.diff(before.inventory).affectedKeys().hasOnly(['stock'])
        && after.inventory.stock is int
        && after.inventory.stock >= 0
        && after.get('flags', {}).diff(before.get('flags', {})).affectedKeys().hasOnly(['isActive'])
        // Hide only when it has sold out; re-list only a product the sell-out
        // rule hid, never one the owner switched off by hand.
        && (after.get('flags', {}).get('isActive', true) == before.get('flags', {}).get('isActive', true)
            || (after.flags.isActive == false && after.inventory.stock == 0)
            || (after.flags.isActive == true && before.get('inactiveReason', null) == 'outOfStock'
                && after.inventory.stock > 0))
        && after.get('inactiveReason', null) in [null, 'outOfStock'];
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
    
    // --- CUSTOMER EXPERIENCE (Carts & Categories) ---
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /items/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if can('products');
    }
    
    // --- MARKETING (Banners) ---
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if can('content');
    }

    // --- COUPONS ---
    // Customers need to read coupons to apply them at checkout, and need to
    // bump `usedCount` by 1 after their order is created so admin limits stay
    // accurate. They must NOT be able to mutate any other coupon field.
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if can('coupons');
      allow update: if can('coupons') || (
        isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedCount', 'updatedAt'])
        && request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }
    
    // --- HOMEPAGE SHOWCASES ---
    match /showcases/{showcaseId} {
      allow read: if true;
      allow write: if can('content');
    }

    // --- HOMEPAGE TESTIMONIALS ---
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if can('content');
    }
    
    // --- CUSTOMER REVIEWS ---
    match /reviews/{reviewId} {
      // Anyone can read approved reviews
      allow read: if true;
      // Authenticated users create their own review; it waits for approval
      // (WriteReview sends 'pending'). The owner may write any review back:
      // that is what Restore from the Recycle bin does.
      allow create: if isAdmin() || (isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending');
      // Only admin can update (approve/reject) or delete reviews
      allow update: if can('content');
      allow delete: if can('content');
    }
    
    // --- HOMEPAGE GALLERY ---
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if can('content');
    }
    
    // --- ORDER FULFILLMENT (Optimized for Delivery Partners with OTP Verification) ---
    match /orders/{orderId} {
      // Helper: Check if user is the assigned delivery partner
      function isAssignedDeliveryBoy() {
        return isAuthenticated() && resource.data.delivery_boy_id == request.auth.uid;
      }
      
      // Helper: Check if user is the order owner (customer)
      function isOrderOwner() {
        return isAuthenticated() && resource.data.userId == request.auth.uid;
      }
      
      // Helper: Validate status transitions for delivery workflow
      function isValidStatusTransition() {
        let currentStatus = resource.data.status;
        let newStatus = request.resource.data.status;
        
        // Delivery boy workflow: shipped/assigned → picked → outForDelivery → delivered
        return (currentStatus == 'shipped' && newStatus == 'picked') ||
               (currentStatus == 'assigned' && newStatus == 'picked') ||
               (currentStatus == 'picked' && newStatus == 'outForDelivery') ||
               (currentStatus == 'outForDelivery' && newStatus == 'delivered');
      }
      
      // Helper: Ensure OTP is only cleared when marking as delivered
      function isValidOTPUpdate() {
        let newStatus = request.resource.data.status;
        // Only allow OTP to be cleared (set to null) when status becomes 'delivered'
        return newStatus == 'delivered' ? 
          (request.resource.data.delivery_otp == null && request.resource.data.otp_verified == true) :
          true;
      }
      
      // Helper: Check if customer is cancelling their own order
      function isValidCancellation() {
        let currentStatus = resource.data.status;
        let newStatus = request.resource.data.status;
        // Customers can only cancel orders that are 'pending' or 'processing'.
        // The fields list stops a "cancellation" from also rewriting the
        // total, the payment status or the refund details.
        return newStatus == 'cancelled' &&
               (currentStatus == 'pending' || currentStatus == 'processing') &&
               request.resource.data.cancelledBy == 'user' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'cancellationReason', 'cancelledAt', 'cancelledBy',
                 'updatedAt', 'lastUpdated', 'statusHistory', 'stockDecremented'
               ]);
      }
      
      // Helper: Check if customer is requesting a return for a delivered order
      function isValidReturnRequest() {
        let currentStatus = resource.data.status;
        let newStatus = request.resource.data.status;
        // The fields list stops a return request from also marking the order
        // paid or changing its total (found in the G1 review).
        return currentStatus == 'delivered' && newStatus == 'returnRequested' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'returnReason', 'returnRequestedAt', 'returnStatus',
                 'updatedAt', 'lastUpdated', 'statusHistory'
               ]);
      }

      // Helper: Assigned delivery partner can mark COD payment as collected
      // without changing the fulfillment status. This keeps collection state
      // persisted on the order instead of being inferred from payment method.
      function isValidCodPaymentCollectionUpdate() {
        return resource.data.paymentMethod == 'Cash On Delivery'
          && resource.data.status == 'outForDelivery'
          && request.resource.data.status == resource.data.status
          && request.resource.data.paymentStatus == 'paid'
          && resource.data.paymentStatus != 'paid'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus',
            'paymentCollectedAt',
            'paymentCollectedBy',
            'paymentCollectedByName',
            'updatedAt',
            'lastUpdated',
            'statusHistory'
          ]);
      }
      
      // READ: Admins see all; Customers see their orders; Delivery boys see assigned orders
      // The Dashboard page totals every order, so its page reads them too.
      allow read: if isAuthenticated() &&
        (resource == null || isOrderOwner() || isAssignedDeliveryBoy() || can('orders') || can('dashboard'));
      
      // A paid order must match the payment /api/verify-payment recorded
      // (gap G1): the order is stored under the payment id, so one payment buys
      // one order, and the customer, total and items must all agree with it.
      function paidLineMatches(items, lines, i) {
        // One map diff per line is cheaper than two field comparisons, and the
        // rules may evaluate at most 1000 expressions per request.
        return i >= lines.size() ||
          !items[i].diff(lines[i]).affectedKeys().hasAny(['productId', 'quantity']);
      }

      function isBackedPaidOrder() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/payments/$(orderId);
        return d.razorpayPaymentId == orderId
          && exists(path)
          && isPaidOrderMatch(d, get(path).data);
      }

      function isPaidOrderMatch(d, p) {
        // Checkout writes the order seconds after the payment is recorded. The
        // hour limit stops a payment buying a second order after the owner
        // deletes the first one.
        return p.userId == request.auth.uid
          && request.time < p.createdAt + duration.value(1, 'h')
          && p.currency == 'INR'
          && d.razorpayOrderId == p.razorpayOrderId
          && d.total is number
          && math.abs(d.total * 100 - p.amountPaise) <= 100
          && d.items is list
          && d.items.size() == p.lines.size()
          && d.items.size() <= 25
          && paidLineMatches(d.items, p.lines, 0) && paidLineMatches(d.items, p.lines, 1)
          && paidLineMatches(d.items, p.lines, 2) && paidLineMatches(d.items, p.lines, 3)
          && paidLineMatches(d.items, p.lines, 4) && paidLineMatches(d.items, p.lines, 5)
          && paidLineMatches(d.items, p.lines, 6) && paidLineMatches(d.items, p.lines, 7)
          && paidLineMatches(d.items, p.lines, 8) && paidLineMatches(d.items, p.lines, 9)
          && paidLineMatches(d.items, p.lines, 10) && paidLineMatches(d.items, p.lines, 11)
          && paidLineMatches(d.items, p.lines, 12) && paidLineMatches(d.items, p.lines, 13)
          && paidLineMatches(d.items, p.lines, 14) && paidLineMatches(d.items, p.lines, 15)
          && paidLineMatches(d.items, p.lines, 16) && paidLineMatches(d.items, p.lines, 17)
          && paidLineMatches(d.items, p.lines, 18) && paidLineMatches(d.items, p.lines, 19)
          && paidLineMatches(d.items, p.lines, 20) && paidLineMatches(d.items, p.lines, 21)
          && paidLineMatches(d.items, p.lines, 22) && paidLineMatches(d.items, p.lines, 23)
          && paidLineMatches(d.items, p.lines, 24);
      }

      // CREATE: Only authenticated users can create their own orders, either
      // unpaid ('pending') or paid and backed by a recorded payment.
      // The owner may write one back (Restore from the Recycle bin).
      // A new customer order starts 'pending' with no delivery details:
      // otherwise a customer could name themselves the delivery partner, or
      // start at 'delivered', and use those update rules to mark it paid.
      // A Razorpay payment id is always the doc id, so one payment can only
      // ever back one order, confirmed or not.
      function isFreshCustomerOrder() {
        let d = request.resource.data;
        return d.status == 'pending'
          && !d.keys().hasAny([
            'delivery_boy_id', 'delivery_boy_name', 'delivery_partner_id', 'delivery_partner_name',
            'delivery_partner_phone', 'deliveryBoyId', 'assignedAt', 'delivery_otp', 'otp_verified',
            'otp_generated_at', 'paymentCollectedAt', 'paymentCollectedBy', 'paymentCollectedByName',
            'deliveredAt', 'returnScheduledAt', 'return_otp', 'return_store_otp'
          ])
          && (!('razorpayPaymentId' in d) || d.razorpayPaymentId == orderId);
      }

      allow create: if isAdmin() || (isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isFreshCustomerOrder() &&
        (request.resource.data.paymentStatus == 'pending' ||
          (request.resource.data.paymentStatus == 'paid' && isBackedPaidOrder())));
        
      // UPDATE: Complex rules for different roles
      // - Admin can update anything
      // - Customers can cancel their own orders (pending/processing only)
      // - Customers can request returns for delivered orders
      // - Delivery boys can only update their assigned orders with valid status transitions
      allow update: if can('orders') || 
        (isOrderOwner() && isValidCancellation()) ||
        (isOrderOwner() && isValidReturnRequest()) ||
        (isAssignedDeliveryBoy() && isValidCodPaymentCollectionUpdate()) ||
        (isAssignedDeliveryBoy() && isValidStatusTransition() && isValidOTPUpdate());
      
      // DELETE: Only admin can delete orders
      allow delete: if can('orders');

      // --- ORDER MESSAGES / IN-APP CHAT ---
      match /messages/{messageId} {
        function parentOrder() {
          return get(/databases/$(database)/documents/orders/$(orderId));
        }

        function isMessageOrderOwner() {
          return isAuthenticated() && parentOrder().data.userId == request.auth.uid;
        }

        function isCustomerMessageWrite() {
          return request.resource.data.authorType == 'customer'
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.visibility == 'customer'
            && request.resource.data.channel == 'chat';
        }

        allow read: if can('orders') ||
          (isMessageOrderOwner() && resource.data.visibility == 'customer');

        allow create: if can('orders') ||
          (isMessageOrderOwner() && isCustomerMessageWrite());

        allow update, delete: if can('orders');
      }
    }

    // --- PAYMENTS (written only by /api/verify-payment) ---
    // One document per verified Razorpay payment, id = the payment id. The
    // server signs in as a service identity whose custom token carries
    // `paymentServer: true`; nobody else can mint that claim. A paid order is
    // only accepted when it matches one of these (see orders above).
    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || can('orders') ||
          (request.auth.uid == 'razorpay-verifier' && request.auth.token.paymentServer == true));
      allow create: if request.auth != null
        && request.auth.uid == 'razorpay-verifier'
        && request.auth.token.paymentServer == true
        && request.resource.data.razorpayPaymentId == paymentId
        && request.resource.data.userId is string
        && request.resource.data.amountPaise is int
        && request.resource.data.currency == 'INR'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lines is list;
      allow update, delete: if false;
    }

    // --- USER FCM TOKENS (web push) ---
    // Document ID = the FCM registration token; data: { uid, token, platform, userAgent, createdAt, updatedAt }
    match /userTokens/{token} {
      // Owner may create or update their own token document
      allow create, update: if isAuthenticated()
                            && request.resource.data.uid == request.auth.uid;
      // Owner may delete their own token (sign-out / unsubscribe)
      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
      // Admin may read all tokens (for the broadcast UI); owner may read their own
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // --- WHATSAPP OTP ARTIFACTS ---
    // Server-only collection. Hashed OTP records are written/verified through
    // the Vercel functions running with the firebase-admin SDK, which bypasses
    // these rules. Block all client access.
    match /whatsappOtps/{doc} {
      allow read, write: if false;
    }

    // --- MARKETING CAMPAIGNS (broadcasts: push + WhatsApp) ---
    // Admin-only. The /api/broadcast endpoint uses the admin SDK (bypasses
    // these rules) to write per-channel results back to the document.
    match /broadcastCampaigns/{campaignId} {
      allow read, write: if can('marketing');
    }

    // --- WHATSAPP TEMPLATE METADATA ---
    // Admin-managed list of approved Cloud-API template names + parameter
    // descriptions used by the Marketing Center composer. Templates themselves
    // are approved in Meta dashboard; this collection only stores metadata
    // for picker UX.
    match /whatsappTemplates/{templateId} {
      allow read: if can('whatsapp') || can('marketing');
      allow write: if can('marketing');
    }

    // --- WHATSAPP INBOX (admin reply console) ---
    // Threaded conversation records populated by the /api/whatsapp-webhook
    // function (admin SDK). Admin-only client access.
    // Team-inbox fields (status, assignedTo) live on the thread doc and
    // internal notes are `messages` docs with direction 'note'; both are
    // covered by the admin-only rules below. Notes are never sent to Meta.
    match /whatsappThreads/{threadId} {
      allow read, write: if can('whatsapp');
      match /messages/{msgId} {
        allow read, write: if can('whatsapp');
      }
    }

    // --- WHATSAPP QUICK-REPLY SNIPPETS (team inbox) ---
    // Saved answers the team inserts into replies. Admin-only.
    match /whatsappSnippets/{snippetId} {
      allow read, write: if can('whatsapp');
    }

    // --- VIDEO CALL SIGNALLING ---
    // Two participants only: caller and callee. SDP offer/answer + ICE
    // candidates live for the duration of the call and are deleted on hangup.
    match /videoCalls/{callId} {
      allow create: if isAuthenticated()
                    && request.resource.data.callerUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated()
                    && (resource.data.callerUid == request.auth.uid
                        || resource.data.calleeUid == request.auth.uid);
      match /callerCandidates/{cand} {
        allow read, write: if isAuthenticated()
                          && (get(/databases/$(database)/documents/videoCalls/$(callId)).data.callerUid == request.auth.uid
                              || get(/databases/$(database)/documents/videoCalls/$(callId)).data.calleeUid == request.auth.uid);
      }
      match /calleeCandidates/{cand} {
        allow read, write: if isAuthenticated()
                          && (get(/databases/$(database)/documents/videoCalls/$(callId)).data.callerUid == request.auth.uid
                              || get(/databases/$(database)/documents/videoCalls/$(callId)).data.calleeUid == request.auth.uid);
      }
    }

    // --- VIDEO CALL REQUESTS (demo booking) ---
    match /videoCallRequests/{reqId} {
      // Customer can create their own request; the owner may write one back
      // (Restore from the Recycle bin).
      allow create: if isAdmin() || (isAuthenticated()
                    && request.resource.data.customerUid == request.auth.uid);
      // Customer can read/update (cancel) their own requests
      allow read, update: if isAuthenticated()
                    && (resource.data.customerUid == request.auth.uid || can('videoCalls'));
      // Only admin can delete
      allow delete: if can('videoCalls');
      // Lists fall under `read` above: customers must query where
      // customerUid == their uid. A blanket list rule here let any signed-in
      // user read every booking.
    }
  
    // --- ACTIVITY LOG & RECYCLE BIN (src/lib/audit/firestore.ts) ---
    // Every admin-panel write by the owner or a team member is logged, and
    // anything removed is copied to the bin first. Entries can't be edited or
    // removed by the team; only the owner reads them, restores or empties.
    match /activityLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdminOrTeam() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /recycleBin/{entryId} {
      allow read, update, delete: if isAdmin();
      // The owner's Restore writes `data` back to `path`, so a team member may
      // only bin a document that exists and that their page lets them delete.
      // Otherwise they could plant users/<id> with role 'admin' and wait for a
      // Restore.
      allow create: if request.resource.data.deletedByUid == request.auth.uid
        && request.resource.data.path is string
        && (isAdmin() || can(binPage(request.resource.data.path)))
        && binTargetExists(request.resource.data.path.split('/'));
    }

    // Built segment by segment: path('...' + p) URL-decodes, so a document id
    // with '+' (a newsletter address like name+tag@gmail.com) or '%' would not
    // be found and its delete would fail.
    function binTargetExists(parts) {
      return parts.size() == 2
        ? exists(/databases/$(database)/documents/$(parts[0])/$(parts[1]))
        : parts.size() == 4
          && exists(/databases/$(database)/documents/$(parts[0])/$(parts[1])/$(parts[2])/$(parts[3]));
    }

    // The page that lets a team member delete the document at `p` ('' = owner only).
    function binPage(p) {
      let parts = p.split('/');
      return parts.size() == 2
        ? {
            'products': 'products', 'categories': 'products',
            'orders': 'orders',
            'coupons': 'coupons',
            'giftCards': 'giftCards',
            'videoCallRequests': 'videoCalls', 'videoCalls': 'videoCalls',
            'newsletterSubscriptions': 'newsletter',
            'promptHistory': 'aiTools',
            'broadcastCampaigns': 'marketing', 'whatsappTemplates': 'marketing',
            'whatsappThreads': 'whatsapp', 'whatsappSnippets': 'whatsapp',
            'homeBanners': 'content', 'homeCollections': 'content', 'homeVideos': 'content',
            'banners': 'content', 'showcases': 'content', 'testimonials': 'content',
            'gallery': 'content', 'reviews': 'content'
          }.get(parts[0], '')
        : parts.size() == 4
          ? {
              'orders/messages': 'orders',
              'whatsappThreads/messages': 'whatsapp',
              'users/giftCards': 'giftCards'
            }.get(parts[0] + '/' + parts[2], '')
          : '';
    }

    // --- DEALER (MANUFACTURER) CHATS ---
    // Staff see a dealer's display name and chat only. The number and real
    // name live in dealerPrivate, which only the owner (and the server) reads.
    // Messages and tickets are written by the server (Admin SDK).
    match /dealers/{dealerId} {
      allow read: if can('dealerChats');
      allow write: if isAdmin();
      match /messages/{msgId} {
        allow read: if can('dealerChats');
        allow write: if isAdmin();
      }
    }
    match /dealerPrivate/{dealerId} {
      allow read, write: if isAdmin();
    }
    match /dealerTickets/{ticketId} {
      allow read: if can('dealerChats');
      // Staff may only open or close a ticket.
      allow update: if isAdmin() || (
        can('dealerChats')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'closedAt', 'closedByUid', 'closedByName', 'updatedAt'])
        && request.resource.data.status in ['open', 'closed']
      );
      allow create, delete: if isAdmin();
    }
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
